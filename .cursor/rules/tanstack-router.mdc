// ~/routes/posts/-components/PostComments.tsx
import { type Comment } from '~/db/schema.ts'

export function PostComments({ postId }: { postId: string }) {
  const { data: comments } = useSuspenseQuery(getPostCommentsQuery(postId))

  if (comments.length === 0) {
    return <div className="text-muted-foreground">コメントはありません</div>
