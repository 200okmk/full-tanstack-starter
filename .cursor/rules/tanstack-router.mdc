// ~/routes/posts/-components/PostsList.tsx
import { useSuspenseQuery } from '@tanstack/react-query'
import { getRouteApi } from '@tanstack/react-router'
import { Card, CardContent, CardHeader, CardTitle, CardDescription } from '~/components/ui/card'
import {
  Pagination,
  PagenationContent,
  ...
} from '~/components/ui/pagination'
import { Skeleton } from '~/components/ui/skeleton'
import { getPostsQuery } from '~/data-access/posts'

const routeApi = getRouteApi('/posts')

export function PostsList({
  updateSearch
}: {
  updateSearch: (updates: Partial<PostsSearch>) => void
}) {
  const searchParams = routeApi.useSearch({
    select: (search) => ({
      page: search.page,
      limit: search.limit,
      sort: search.sort,
      category: search.category,
    }),
    structuralSharing: true,
  })

  const { data } = useSuspenseQuery(getPostsQuery(searchParams))

  if (data.posts.length === 0) {
    return (
      <section>
      ...
      </section>
    )
  }

  return (
    <section>
      <div>
        {data.posts.map((post) => (
          <Card key={post.id}>
            ...
          </Card>
        ))}
      </div>
      <div>
        {/* データを持っているコンポーネント内でPaginationを表示 */}
        <PostsPagination
          currentPage={searchParams.page}
          totalPages={data.totalPages}
          onPageChange={(newPage) => updateSearch({ page: newPage })}
        />
      </div>
    </section>
  )
}

export function PostsListSkeleton() {
  return (
    <div>
      {Array.from({ length: 5 }).map((_, i) => (
        <Card key={i}>
          <CardHeader>
            <Skeleton className="..." />
            ...
          </CardHeader>
          <CardContent>
            <Skeleton className="..." />
            ...
          </CardContent>
        </Card>
      ))}
    </div>
  )
}

