          <li key={c.id}>
            <PostCommentItem comment={c}>
          </li>
        ))}
      </ul>
    </div>
  )
}

function PostCommentItem ({ comment }: { comment: Comment}) {
  return (
    <div>
    ...
    </div>
  )
}

function PostCommentsSkeleton() {
  return (
    <div className="...">
      <Skeleton className="..." />
      <Skeleton className="..." />
      ...
    </div>
  )
}
