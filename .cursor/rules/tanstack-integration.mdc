# TanStack エコシステム統合戦略

このルールは、TanStack Start、Router、Queryの3つの核となるライブラリを統合し、フルスタックアプリケーションの構築における包括的な戦略を定義します。サーバー関数、SSR、ストリーミング、型安全性を中心とした統合アプローチを採用します。

## 📡 サーバー関数とクライアント統合

### サーバー関数の型安全な定義
Zodを使用した堅牢なバリデーション付きサーバー関数を実装します。

```tsx
// src/serverFn/posts.ts
import { createServerFn } from '@tanstack/start'
import { z } from 'zod'
import { db } from '../lib/db'
import { posts } from '../lib/db/schemas'

// 投稿取得用のクエリスキーマ
const getPostsSchema = z.object({
  page: z.number().min(1).default(1),
  limit: z.number().min(1).max(100).default(20),
  category: z.string().optional(),
  status: z.enum(['draft', 'published', 'archived']).default('published'),
})

// 投稿作成用のスキーマ
const createPostSchema = z.object({
  title: z.string().min(1).max(200),
  content: z.string().min(1),
  category: z.string().optional(),
  tags: z.array(z.string()).default([]),
})

export const getPosts = createServerFn({
  method: 'GET',
})
  .validator(getPostsSchema)
  .handler(async ({ data }) => {
    const { page, limit, category, status } = data

    try {
      const query = db
        .select()
        .from(posts)
        .where(eq(posts.status, status))
        .limit(limit)
        .offset((page - 1) * limit)

      if (category) {
        query.where(eq(posts.category, category))
      }

      const result = await query
      const total = await db.select({ count: count() }).from(posts).where(eq(posts.status, status))

      return {
        posts: result,
        pagination: {
          page,
          limit,
          total: total[0].count,
          totalPages: Math.ceil(total[0].count / limit),
        },
      }
    } catch (error) {
      console.error('Failed to fetch posts:', error)
      throw new Error('Failed to fetch posts')
    }
  })

export const createPost = createServerFn({
  method: 'POST',
})
  .validator(createPostSchema)
  .handler(async ({ data, context }) => {
    // 認証チェック
    if (!context.user) {
      throw new Error('Authentication required')
    }

    try {
      const [newPost] = await db
        .insert(posts)
        .values({
          ...data,
          authorId: context.user.id,
          createdAt: new Date(),
          updatedAt: new Date(),
        })
        .returning()

      return newPost
    } catch (error) {
      console.error('Failed to create post:', error)
      throw new Error('Failed to create post')
    }
  })
```

### ストリーミング対応サーバー関数
リアルタイムデータストリーミングを実装します。

```tsx
// src/serverFn/streaming.ts
import { createServerFn } from '@tanstack/start'

export const streamEvents = createServerFn({
  method: 'GET',
  response: 'raw', // ストリーミング応答を有効化
}).handler(async ({ signal }) => {
  const stream = new ReadableStream({
    async start(controller) {
      // 初期接続確認
      controller.enqueue(
        new TextEncoder().encode('data: {"type":"connected","timestamp":"' + new Date().toISOString() + '"}\n\n')
      )

      let eventCount = 0
      const interval = setInterval(async () => {
        // クライアント切断チェック
        if (signal.aborted) {
          clearInterval(interval)
          controller.close()
          return
        }

        // イベントデータの送信
        const eventData = {
          type: 'update',
          id: ++eventCount,
          timestamp: new Date().toISOString(),
          data: await fetchLatestData(), // 実際のデータ取得
        }

        controller.enqueue(
          new TextEncoder().encode(`data: ${JSON.stringify(eventData)}\n\n`)
        )

        // 10回送信後に終了
        if (eventCount >= 10) {
          clearInterval(interval)
          controller.enqueue(
            new TextEncoder().encode('data: {"type":"completed"}\n\n')
          )
          controller.close()
        }
      }, 1000)

      // シグナル中断時のクリーンアップ
      signal.addEventListener('abort', () => {
        clearInterval(interval)
        controller.close()
      })
    },
  })

  return new Response(stream, {
    headers: {
      'Content-Type': 'text/event-stream',
      'Cache-Control': 'no-cache',
      'Connection': 'keep-alive',
      'Access-Control-Allow-Origin': '*',
      'Access-Control-Allow-Headers': 'Cache-Control',
    },
  })
})

async function fetchLatestData() {
  // データベースから最新データを取得する実装
  return {
    activeUsers: Math.floor(Math.random() * 100),
    newPosts: Math.floor(Math.random() * 10),
    systemLoad: Math.random() * 100,
  }
}
```



## 🔄 楽観的更新とサーバー状態同期

### 楽観的更新パターンの実装
サーバー関数とクエリキャッシュの一貫性を保つ楽観的更新を実装します。

```tsx
// src/hooks/usePosts.ts
import { useMutation, useQueryClient } from '@tanstack/react-query'
import { useRouter } from '@tanstack/react-router'
import { createPost } from '../server/posts'
import { toast } from 'sonner'

export function useCreatePost() {
  const queryClient = useQueryClient()
  const router = useRouter()

  return useMutation({
    mutationFn: createPost,

    // 楽観的更新の実行
    onMutate: async (newPost) => {
      // 進行中のクエリをキャンセル
      await queryClient.cancelQueries({ queryKey: ['posts'] })

      // 現在のデータのスナップショット
      const previousPosts = queryClient.getQueriesData({ queryKey: ['posts'] })

      // 楽観的に新しい投稿を追加
      queryClient.setQueriesData<PostsResponse>(
        { queryKey: ['posts'] },
        (old) => {
          if (!old) return old

          const optimisticPost = {
            id: `temp-${Date.now()}`,
            ...newPost,
            createdAt: new Date(),
            updatedAt: new Date(),
            status: 'published' as const,
          }

          return {
            ...old,
            posts: [optimisticPost, ...old.posts],
            pagination: {
              ...old.pagination,
              total: old.pagination.total + 1,
            },
          }
        }
      )

      return { previousPosts }
    },

    // 成功時の処理
    onSuccess: (data, variables, context) => {
      // サーバーからの実際のデータでキャッシュを更新
      queryClient.setQueriesData<PostsResponse>(
        { queryKey: ['posts'] },
        (old) => {
          if (!old) return old

          return {
            ...old,
            posts: old.posts.map(post =>
              post.id.toString().startsWith('temp-') ? data : post
            ),
          }
        }
      )

      // 関連するクエリを無効化
      queryClient.invalidateQueries({ queryKey: ['posts'] })

      // 成功通知
      toast.success('投稿が作成されました')

      // 必要に応じて新しい投稿ページにナビゲート
      router.navigate({ to: `/posts/${data.id}` })
    },

    // エラー時のロールバック
    onError: (error, variables, context) => {
      // 楽観的更新を取り消し
      if (context?.previousPosts) {
        context.previousPosts.forEach(([queryKey, data]) => {
          queryClient.setQueryData(queryKey, data)
        })
      }

      // エラー通知
      toast.error('投稿の作成に失敗しました', {
        description: error.message,
      })
    },

    // 完了時の処理
    onSettled: () => {
      // 整合性を保証するため関連クエリを無効化
      queryClient.invalidateQueries({ queryKey: ['posts'] })
    },
  })
}
```

## 🎨 Suspense とエラーバウンダリ統合

### 階層的 Suspense 戦略
コンテンツの重要度に応じた段階的レンダリングを実装します。

```tsx
// src/routes/dashboard/index.tsx
import { createFileRoute } from '@tanstack/react-router'
import { Suspense } from 'react'
import { useSuspenseQueries } from '@tanstack/react-query'

export const Route = createFileRoute('/dashboard/')({
  component: DashboardPage,
})

function DashboardPage() {
  return (
    <div className="dashboard">
      {/* 即座に表示される静的コンテンツ */}
      <DashboardHeader />
      <DashboardNavigation />

      {/* 最重要データ：最優先で並列フェッチ */}
      <Suspense fallback={<CriticalDataSkeleton />}>
        <CriticalDashboardData />
      </Suspense>

      {/* 重要データ：独立したSuspense境界で並列処理 */}
      <div className="dashboard-sections">
        <Suspense fallback={<UserStatsSkeleton />}>
          <UserStatsSection />
        </Suspense>

        <Suspense fallback={<RecentActivitySkeleton />}>
          <RecentActivitySection />
        </Suspense>
      </div>

      {/* 補助データ：遅延ローディング */}
      <Suspense fallback={<SecondaryDataSkeleton />}>
        <RecommendationsSection />
        <AnalyticsSection />
      </Suspense>
    </div>
  )
}

function CriticalDashboardData() {
  // 複数の重要なクエリを並列実行
  const [userQuery, notificationsQuery, tasksQuery] = useSuspenseQueries({
    queries: [
      {
        queryKey: ['user', 'current'],
        queryFn: getCurrentUser,
        staleTime: 5 * 60 * 1000,
      },
      {
        queryKey: ['notifications', 'urgent'],
        queryFn: getUrgentNotifications,
        staleTime: 1 * 60 * 1000,
      },
      {
        queryKey: ['tasks', 'today'],
        queryFn: getTodayTasks,
        staleTime: 2 * 60 * 1000,
      },
    ],
  })

  return (
    <div className="critical-data-section">
      <UserProfileCard user={userQuery.data} />
      <UrgentNotificationsList notifications={notificationsQuery.data} />
      <TodayTasksList tasks={tasksQuery.data} />
    </div>
  )
}
```

### エラーバウンダリ統合パターン
RouteエラーとQueryエラーを統合的に処理します。

```tsx
// src/components/DefaultCatchBoundary.tsx
import { ErrorComponent, ErrorComponentProps } from '@tanstack/react-router'
import { QueryErrorResetBoundary } from '@tanstack/react-query'
import { Button } from './ui/button'

export function DefaultCatchBoundary({ error, reset }: ErrorComponentProps) {
  return (
    <QueryErrorResetBoundary>
      {({ reset: resetQueries }) => (
        <div className="error-boundary">
          <div className="error-content">
            <h1>予期しないエラーが発生しました</h1>
            <p>申し訳ございませんが、アプリケーションでエラーが発生しました。</p>

            <div className="error-actions">
              <Button
                onClick={() => {
                  resetQueries() // クエリをリセット
                  reset() // ルートをリセット
                }}
                variant="default"
              >
                再試行
              </Button>

              <Button
                onClick={() => {
                  window.location.href = '/'
                }}
                variant="outline"
              >
                ホームに戻る
              </Button>
            </div>

            {process.env.NODE_ENV === 'development' && (
              <details className="error-details">
                <summary>エラー詳細</summary>
                <pre>{error.stack}</pre>
              </details>
            )}
          </div>
        </div>
      )}
    </QueryErrorResetBoundary>
  )
}
```

## 🔧 開発体験とデバッグ

### サーバー関数デバッギング戦略
開発環境でのサーバー関数デバッグを支援する機能を実装します。

```tsx
// src/lib/server-utils.ts
import { createMiddleware } from '@tanstack/start'

export const loggingMiddleware = createMiddleware().server(async ({ next, context }) => {
  const startTime = Date.now()
  const requestId = Math.random().toString(36).substr(2, 9)

  console.log(`[${requestId}] Server function started:`, {
    method: context.request.method,
    url: context.request.url,
    timestamp: new Date().toISOString(),
  })

  try {
    const result = await next()

    console.log(`[${requestId}] Server function completed:`, {
      duration: Date.now() - startTime,
      success: true,
    })

    return result
  } catch (error) {
    console.error(`[${requestId}] Server function failed:`, {
      duration: Date.now() - startTime,
      error: error.message,
      stack: error.stack,
    })

    throw error
  }
})

// サーバー関数での使用例
export const debuggedServerFn = createServerFn()
  .middleware([loggingMiddleware])
  .handler(async () => {
    // サーバー関数の実装
  })
```

## 📊 パフォーマンス最適化戦略

### クエリキー標準化とキャッシュ効率化
一貫性のあるクエリキー設計でキャッシュ効率を最大化します。

```tsx
// src/lib/query-keys.ts
export const queryKeys = {
  // ユーザー関連
  users: {
    all: ['users'] as const,
    lists: () => [...queryKeys.users.all, 'list'] as const,
    list: (filters: UserFilters) => [...queryKeys.users.lists(), filters] as const,
    details: () => [...queryKeys.users.all, 'detail'] as const,
    detail: (id: string) => [...queryKeys.users.details(), id] as const,
    profile: (id: string) => [...queryKeys.users.detail(id), 'profile'] as const,
    preferences: (id: string) => [...queryKeys.users.detail(id), 'preferences'] as const,
  },

  // 投稿関連
  posts: {
    all: ['posts'] as const,
    lists: () => [...queryKeys.posts.all, 'list'] as const,
    list: (filters: PostFilters) => [...queryKeys.posts.lists(), filters] as const,
    details: () => [...queryKeys.posts.all, 'detail'] as const,
    detail: (id: string) => [...queryKeys.posts.details(), id] as const,
    comments: (id: string) => [...queryKeys.posts.detail(id), 'comments'] as const,
  },
} as const

// クエリファクトリ
export const userQueries = {
  profile: (userId: string) => ({
    queryKey: queryKeys.users.profile(userId),
    queryFn: () => getUserProfile(userId),
    staleTime: 10 * 60 * 1000,
  }),

  preferences: (userId: string) => ({
    queryKey: queryKeys.users.preferences(userId),
    queryFn: () => getUserPreferences(userId),
    staleTime: 30 * 60 * 1000,
  }),
} as const
```
