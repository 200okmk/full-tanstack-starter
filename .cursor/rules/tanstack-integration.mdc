# TanStack Integration Rule

### Server Function エラーハンドリング

```tsx
// ✅ エラーレスポンスの標準化（schema.ts完全準拠）
import { setResponseStatus } from "@tanstack/react-start/server";
import { postSelectSchema, postsTable } from "~/db/schema"; // ✅ schema.tsからインポート

export const getPost = createServerFn({
  method: "GET",
})
  .validator(postSelectSchema.pick({ id: true })) // ✅ schema.tsのスキーマ使用
  .handler(async ({ data: { id: postId } }) => {
    try {
      const [post] = await db.select().from(postsTable).where(eq(postsTable.id, postId));

      if (!post) {
        setResponseStatus(404);
        throw new Error("Post not found");
      }

      return post;
    } catch (error) {
      // ログ記録
      console.error("Failed to fetch post:", error);

      if (error.message === "Post not found") {
        throw error;
      }

      setResponseStatus(500);
      throw new Error("Failed to fetch post");
    }
  });
```
