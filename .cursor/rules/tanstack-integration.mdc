## ⚡ パフォーマンス最適化

### 重要度別Suspense境界設計

```tsx
function DashboardPage() {
  return (
    <div className="dashboard">
      {/* 即座に表示される静的コンテンツ */}
      <DashboardHeader />
      <Navigation />

      {/* 重要なデータ - 並列フェッチで即座に表示 */}
      <Suspense fallback={<CriticalDataSkeleton />}>
        <CriticalDashboardData />
      </Suspense>

      {/* 補助的なデータ - 独立してフェッチ */}
      <Suspense fallback={<SecondaryDataSkeleton />}>
        <SecondaryDashboardData />
      </Suspense>

      {/* 非重要なデータ - 最後にフェッチ */}
      <Suspense fallback={<OptionalDataSkeleton />}>
        <OptionalDashboardData />
      </Suspense>
    </div>
  )
}

// 重要なデータコンポーネント
function CriticalDashboardData() {
  const { data: profile } = useSuspenseQuery({
    queryKey: ['user-profile'],
    queryFn: getUserProfile,
  })

  const { data: stats } = useSuspenseQuery({
    queryKey: ['user-stats'],
    queryFn: getUserStats,
  })

  return (
    <div className="grid grid-cols-2">
      <UserProfileCard profile={profile} />
      <UserStatsCard stats={stats} />
    </div>
  )
}
```

### 効率的なキャッシュ戦略

```tsx
// キャッシュ無効化の効率的なパターン
export const createPost = createServerFn({
  method: 'POST',
})
  .validator(createPostSchema)
  .handler(async ({ data, context }) => {
    const newPost = await db.insert(posts).values({
      ...data,
      authorId: context.user.id,
      createdAt: new Date(),
    }).returning()

    return newPost[0]
  })

// クライアントサイドでの使用
function CreatePostForm() {
  const queryClient = useQueryClient()

  const createPostMutation = useMutation({
    mutationFn: createPost,
    onSuccess: (newPost) => {
      // ★ 関連するクエリを効率的に無効化
      queryClient.invalidateQueries({ queryKey: ['posts'] })
      queryClient.invalidateQueries({ queryKey: ['user-posts'] })

      // ★ 新しい投稿を既存キャッシュに楽観的に追加
      queryClient.setQueryData(['posts'], (oldPosts: Post[]) =>
        [newPost, ...(oldPosts || [])]
      )
    },
  })

  return <PostForm onSubmit={createPostMutation.mutate} />
}
```

## 🎯 エラーハンドリング統合

### 統合エラーバウンダリ戦略

```tsx
// Route レベルエラーハンドリング
export const Route = createFileRoute('/posts/$postId')({
  loader: async ({ context, params }) => {
    try {
      await context.queryClient.ensureQueryData({
        queryKey: ['post', params.postId],
        queryFn: () => getPost(params.postId),
      })
    } catch (error) {
      // ★ 404エラーは適切にハンドリング
      if (error.status === 404) {
        throw notFound()
      }
      throw error
    }
  },

  errorComponent: ({ error, reset }) => {
    if (error.status === 404) {
      return <PostNotFound />
    }

    return (
      <div className="error-container">
        <h2>Something went wrong</h2>
        <p>{error.message}</p>
        <button onClick={reset}>Try again</button>
      </div>
    )
  },

  component: PostComponent,
})
```

### Server Function エラーハンドリング

```tsx
// エラーレスポンスの標準化
export const getPost = createServerFn({
  method: 'GET',
})
  .validator(z.string())
  .handler(async ({ data: postId }) => {
    try {
      const [post] = await db
        .select()
        .from(posts)
        .where(eq(posts.id, postId))

      if (!post) {
        setResponseStatus(404)
        throw new Error('Post not found')
      }

      return post
    } catch (error) {
      // ログ記録
      console.error('Failed to fetch post:', error)

      if (error.message === 'Post not found') {
        throw error
      }

      setResponseStatus(500)
      throw new Error('Failed to fetch post')
    }
  })
```

