### **命名規則の統一**

```tsx
// ✅ 推奨: 一貫した命名パターン
export const usersTable = pgTable("users", { /* ... */ });           // テーブル: {entity}Table
export const userInsertSchema = createInsertSchema(usersTable);       // スキーマ: {entity}{Operation}Schema
export const userSelectSchema = createSelectSchema(usersTable);       // スキーマ: {entity}{Operation}Schema
export type User = typeof usersTable.$inferSelect;                    // 型: {Entity}（DB内部用）
export type ValidatedUserInsert = z.infer<typeof userInsertSchema>;   // 型: Validated{Entity}{Operation}（検証付き）

// ❌ 非推奨: 不一致な命名
export const users = pgTable("users", { /* ... */ });                // テーブル名の不一致
export const createUserSchema = createInsertSchema(users);            // 動詞形の使用
export type UserType = typeof users.$inferSelect;                     // 不必要なサフィックス
