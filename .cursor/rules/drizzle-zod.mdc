#### **✅ 基本統合パターン**

```tsx
// ❌ 避けるべき独自定義
const customUserSchema = z.object({
  name: z.string(),
  email: z.string().email(),
});

// ✅ 推奨: schema.tsからインポート
import { userInsertSchema, userSelectSchema, User, UserInsert } from "~/db/schema";

// ユーティリティ関数統合
export function validateUserData(data: unknown): UserInsert | null {
  const result = userInsertSchema.safeParse(data);
  return result.success ? result.data : null;
}

// 型ガード関数
export function isValidUser(data: unknown): data is User {
  return userSelectSchema.safeParse(data).success;
}
```

## 🔧 TanStack Start統合実装パターン

### **src/server/ディレクトリ管理戦略**

```
src/
├── server/
│   ├── users.ts          # ユーザー関連 Server Functions
│   ├── posts.ts          # 投稿関連 Server Functions
│   ├── comments.ts       # コメント関連 Server Functions
│   └── auth.ts           # 認証関連 Server Functions
```

### **📋 Entityごとの標準実装パターン**

```tsx
// src/server/users.ts - ユーザー関連 Server Functions
import { createServerFn } from "@tanstack/react-start";
import { eq, like, desc, count } from "drizzle-orm";
import { db } from "~/db";
import {
  usersTable,
  postsTable,
  userInsertSchema,
  userUpdateSchema,
  type User,
  type UserInsert,
  type UserUpdate,
} from "~/db/schema";

// ✅ CREATE - バリデーション + 重複チェック + トランザクション
export const createUser = createServerFn({
  method: "POST",
})
  .validator(userInsertSchema)
  .handler(async ({ data }) => {
    return await db.transaction(async (tx) => {
      // 重複チェック
      const existing = await tx
        .select({ id: usersTable.id })
        .from(usersTable)
        .where(eq(usersTable.email, data.email))
        .limit(1);

      if (existing.length > 0) {
        throw new Error("メールアドレスが既に存在します");
      }

      // 新規作成
      const [user] = await tx.insert(usersTable).values(data).returning();
      return user;
    });
  });

// ✅ READ - JOIN + 集計 + ページング
export const getUsers = createServerFn({
  method: "GET",
})
  .validator(z.object({
    page: z.number().min(1).default(1),
    limit: z.number().min(1).max(100).default(10),
    search: z.string().optional(),
  }))
  .handler(async ({ data: { page, limit, search } }) => {
    const offset = (page - 1) * limit;

    return await db
      .select({
        id: usersTable.id,
        name: usersTable.name,
        email: usersTable.email,
        postCount: count(postsTable.id),
        createdAt: usersTable.createdAt,
      })
      .from(usersTable)
      .leftJoin(postsTable, eq(usersTable.id, postsTable.userId))
      .where(search ? like(usersTable.name, `%${search}%`) : undefined)
      .groupBy(usersTable.id)
      .orderBy(desc(usersTable.createdAt))
      .limit(limit)
      .offset(offset);
  });

// ✅ UPDATE - 部分更新 + 楽観的ロック
export const updateUser = createServerFn({
  method: "PUT",
})
  .validator(z.object({
    id: z.string(),
    data: userUpdateSchema,
    version: z.number().optional(),
  }))
  .handler(async ({ data: { id, data, version } }) => {
    return await db.transaction(async (tx) => {
      // 楽観的ロック（version指定時）
      if (version !== undefined) {
        const current = await tx
          .select({ updatedAt: usersTable.updatedAt })
          .from(usersTable)
          .where(eq(usersTable.id, id))
          .limit(1);

        if (current.length === 0) {
          throw new Error("ユーザーが見つかりません");
        }

        if (current[0].updatedAt.getTime() !== version) {
          throw new Error("データが他のユーザーによって更新されています");
        }
      }

      const [user] = await tx
        .update(usersTable)
        .set({ ...data, updatedAt: new Date() })
        .where(eq(usersTable.id, id))
        .returning();

      return user;
    });
  });

// ✅ DELETE - カスケード削除対応
export const deleteUser = createServerFn({
  method: "DELETE",
})
  .validator(z.object({
    id: z.string(),
  }))
  .handler(async ({ data: { id } }) => {
    const [deletedUser] = await db
      .delete(usersTable)
      .where(eq(usersTable.id, id))
      .returning();

    if (!deletedUser) {
      throw new Error("ユーザーが見つかりません");
    }

    return { success: true, deletedUser };
  });
```

### **認証統合パターン**

```tsx
// 認証保護されたServer Function
export const createPost = createServerFn({
  method: "POST",
})
  .validator(postInsertSchema.omit({ userId: true }))
  .handler(async ({ data, context }) => {
    // 認証チェック（@tanstack-start.mdcのミドルウェア統合を活用）
    if (!context.sessionUser) {
      throw new Error("認証が必要です");
    }

    const [post] = await db
      .insert(postsTable)
      .values({ ...data, userId: context.sessionUser.id })
      .returning();

    return post;
  });
```

### **複雑なクエリパターン**

```tsx
// リレーション + 条件フィルタ
export const getUserWithPosts = createServerFn({
  method: "GET",
})
  .validator(z.object({
    userId: z.string(),
    includeUnpublished: z.boolean().default(false),
  }))
  .handler(async ({ data: { userId, includeUnpublished } }) => {
    const [user] = await db
      .select()
      .from(usersTable)
      .where(eq(usersTable.id, userId))
      .limit(1);

    if (!user) {
      throw new Error("ユーザーが見つかりません");
    }

    const posts = await db
      .select()
      .from(postsTable)
      .where(
        and(
          eq(postsTable.userId, userId),
          includeUnpublished ? undefined : eq(postsTable.published, true)
        )
      )
      .orderBy(desc(postsTable.createdAt));

    return { user, posts };
  });
```

## 🚨 エラーハンドリング統合戦略

### **エラー分類と標準化**

```tsx
// src/lib/errors.ts - 統一的なエラーハンドリング
export class ValidationError extends Error {
  constructor(message: string, public field?: string) {
    super(message);
    this.name = 'ValidationError';
  }
}

export class NotFoundError extends Error {
  constructor(message: string) {
    super(message);
    this.name = 'NotFoundError';
  }
}

export class ConflictError extends Error {
  constructor(message: string) {
    super(message);
    this.name = 'ConflictError';
  }
}
```

### **Server Functions エラーハンドリング**

```tsx
// 統一的なエラーハンドリングパターン
export const createUser = createServerFn({
  method: "POST",
})
  .validator(userInsertSchema)
  .handler(async ({ data }) => {
    try {
      return await db.transaction(async (tx) => {
        const existing = await tx
          .select({ id: usersTable.id })
          .from(usersTable)
          .where(eq(usersTable.email, data.email))
          .limit(1);

        if (existing.length > 0) {
          throw new ConflictError("メールアドレスが既に存在します");
        }

        const [user] = await tx.insert(usersTable).values(data).returning();
        return user;
      });
    } catch (error) {
      // エラーログ
      console.error('User creation failed:', error);

      // 型に応じたエラーレスポンス
      if (error instanceof ConflictError) {
        throw error;
      }

      throw new Error('ユーザー作成に失敗しました');
    }
  });
```

### **クライアントサイドエラーハンドリング**

```tsx
// TanStack Query mutation での統一エラーハンドリング
export function useCreateUser() {
  const queryClient = useQueryClient();

  return useMutation({
    mutationFn: createUser,
    onSuccess: (user) => {
      // 成功時のキャッシュ更新
      queryClient.invalidateQueries({ queryKey: ['users'] });
      queryClient.setQueryData(['user', user.id], user);
    },
    onError: (error) => {
      // エラー種別に応じた処理
      if (error.name === 'ConflictError') {
        // 重複エラーの場合の処理
        console.error('Conflict error:', error.message);
      } else if (error.name === 'ValidationError') {
        // バリデーションエラーの場合の処理
        console.error('Validation error:', error.message);
      } else {
        // その他のエラー
        console.error('Unexpected error:', error);
      }
    }
  });
}
```

### **統合エラーバウンダリ**

```tsx
// エラーバウンダリでの統一エラーハンドリング
export function ApiErrorBoundary({ children }: { children: React.ReactNode }) {
  return (
    <ErrorBoundary
      fallback={({ error, reset }) => {
        if (error.name === 'NotFoundError') {
          return <NotFoundComponent />;
        }

        if (error.name === 'ValidationError') {
          return <ValidationErrorComponent error={error} reset={reset} />;
        }

        return <GenericErrorComponent error={error} reset={reset} />;
      }}
    >
      {children}
    </ErrorBoundary>
  );
}
```

## 🔄 実装時の注意点

### **必須事項**

1. **Schema Factory設定**: プロジェクト全体で統一的な型変換ルールを適用
2. **命名規則の徹底**: テーブル名、スキーマ名、型名の一貫性を保つ
3. **Single Source of Truth**: 独自のZodスキーマ定義を避け、drizzle-zodで生成されたスキーマを使用
4. **適切なエラーハンドリング**: Server Functions、クライアントサイドの両方で統一的なエラー処理

### **ベストプラクティス**

1. **型安全性の確保**: `$inferSelect`、`$inferInsert`、`z.infer<typeof schema>`を適切に使用
2. **パフォーマンス最適化**: 必要最小限のデータのみを取得し、適切にインデックスを設定
3. **トランザクション活用**: データ整合性が重要な処理では必ずトランザクションを使用
4. **楽観的ロック**: 競合状態を考慮した更新処理の実装

### **@tanstack-start.mdcとの連携**

- **Server Functions**: 詳細なMiddleware実装、認証統合、ストリーミング対応は@tanstack-start.mdcを参照
- **エラーハンドリング**: 統一的なエラーレスポンス、ログ記録、モニタリングは@tanstack-start.mdcを参照
- **パフォーマンス**: キャッシュ戦略、並列処理、最適化手法は@tanstack-start.mdcを参照

このルールに従うことで、drizzle-zodによるSingle Source of Truthを確立し、型安全で保守性の高いデータベース操作を実現できます。
