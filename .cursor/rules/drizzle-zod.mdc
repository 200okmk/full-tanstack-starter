#### **✅ 統合パターン例**

```tsx
// ❌ 避けるべき独自定義
const customUserSchema = z.object({
  name: z.string(),
  email: z.string().email(),
  // 独自に定義したスキーマ
});

// ✅ 推奨: schema.tsからインポート
import { userInsertSchema, userSelectSchema, User, ValidatedUserInsert } from "~/db/schema";

// Server Function統合
export const createUser = createServerFn({
  method: "POST",
})
  .validator(userInsertSchema) // ★ schema.tsで生成されたスキーマを使用
  .handler(async ({ data }) => {
    // data は ValidatedUserInsert 型として自動推論
    const [user] = await db.insert(usersTable).values(data).returning();
    return user; // User 型として自動推論
  });


// ユーティリティ関数統合
export function transformUserData(rawData: unknown): ValidatedUserInsert {
  return userInsertSchema.parse(rawData); // ★ schema.tsで定義された検証ロジック
}

export function isValidUser(data: unknown): data is User {
  return userSelectSchema.safeParse(data).success; // ★ 型ガード関数も統一
}

// テスト統合
export function createMockUser(overrides?: Partial<ValidatedUserInsert>): User {
  const defaultUser = {
    id: 1,
    name: "Test User",
    email: "test@example.com",
    createdAt: new Date(),
    updatedAt: new Date(),
    ...overrides,
  };

  return userSelectSchema.parse(defaultUser); // ★ テストデータも同じスキーマで検証
}

// TanStack Query統合
function useUser(userId: string) {
  return useSuspenseQuery({
    queryKey: ["user", userId],
    queryFn: () => getUserById(userId), // ★ 戻り値は User 型として自動推論
  });
}

// TanStack Router統合
export const Route = createFileRoute("/users/$userId")({
  loader: async ({ context, params }) => {
    // ★ パラメータ検証も統一スキーマで
    const userId = z.string().parse(params.userId);

    await context.queryClient.ensureQueryData({
      queryKey: ["user", userId],
      queryFn: () => getUserById(userId),
    });
  },
  component: UserDetailComponent,
});
```

**重要原則**: 新しいデータ構造や検証ロジックが必要な場合は、まず`schema.ts`への追加を検討し、既存スキーマの拡張や組み合わせで解決できないかを判断してから独自定義を行う。


## 🔍 クエリビルド標準

### **SQLライク記法の徹底**

```tsx
// src/server/users.ts
import { createServerFn } from "@tanstack/react-start";
import { eq, and, or, desc, asc, count, like, inArray } from "drizzle-orm";
import { db } from "~/db";
import { usersTable, postsTable, userInsertSchema, userSelectSchema } from "~/db/schema";

// ✅ 推奨: SQLライク記法による明確なクエリ
export const getUsers = createServerFn({
  method: "GET",
}).handler(async () => {
  const users = await db
    .select({
      id: usersTable.id,
      name: usersTable.name,
      email: usersTable.email,
      postCount: count(postsTable.id),
    })
    .from(usersTable)
    .leftJoin(postsTable, eq(usersTable.id, postsTable.userId))
    .groupBy(usersTable.id)
    .orderBy(desc(usersTable.createdAt))
    .limit(50);

  return users;
});

// ✅ 複雑な条件クエリ
export const searchUsers = createServerFn({
  method: "GET",
})
  .validator(z.object({
    query: z.string().min(1),
    role: z.enum(["admin", "user"]).optional(),
    isActive: z.boolean().optional(),
  }))
  .handler(async ({ data }) => {
    const { query, role, isActive } = data;

    const users = await db
      .select()
      .from(usersTable)
      .where(
        and(
          or(
            like(usersTable.name, `%${query}%`),
            like(usersTable.email, `%${query}%`)
          ),
          role ? eq(usersTable.role, role) : undefined,
          isActive !== undefined ? eq(usersTable.isActive, isActive) : undefined
        )
      )
      .orderBy(asc(usersTable.name));

    return users;
  });

// ✅ トランザクション処理
export const createUserWithProfile = createServerFn({
  method: "POST",
})
  .validator(userInsertSchema)
  .handler(async ({ data }) => {
    const result = await db.transaction(async (tx) => {
      const [user] = await tx
        .insert(usersTable)
        .values(data)
        .returning();

      const [profile] = await tx
        .insert(userProfilesTable)
        .values({
          userId: user.id,
          bio: "",
          avatar: null,
        })
        .returning();

      return { user, profile };
    });

    return result;
  });
```

### **バッチ処理とパフォーマンス最適化**

```tsx
// ✅ 推奨: バッチ処理による効率化
export const bulkCreatePosts = createServerFn({
  method: "POST",
})
  .validator(z.object({
    posts: z.array(postInsertSchema).min(1).max(100),
  }))
  .handler(async ({ data }) => {
    const posts = await db
      .insert(postsTable)
      .values(data.posts)
      .returning();

    return posts;
  });

// ✅ 推奨: プリペアドステートメントの活用
export const getUserById = createServerFn({
  method: "GET",
})
  .validator(z.string())
  .handler(async ({ data: userId }) => {
    const preparedQuery = db
      .select()
      .from(usersTable)
      .where(eq(usersTable.id, $userId))
      .prepare();

    const user = await preparedQuery.execute({ userId });
    return user[0];
  });
```

## 💾 Server Functions統合

### **専用ディレクトリ管理**

```tsx
// src/server/index.ts - エクスポート統合
export * from "./users";
export * from "./posts";
export * from "./comments";
export * from "./auth";

// src/server/users.ts - ユーザー関連の操作
import { createServerFn } from "@tanstack/react-start";
import { authMiddleware } from "~/lib/middleware/auth-guard";
import { db } from "~/db";
import { usersTable, userInsertSchema, userUpdateSchema } from "~/db/schema";

export const createUser = createServerFn({
  method: "POST",
})
  .validator(userInsertSchema)
  .handler(async ({ data }) => {
    const [user] = await db
      .insert(usersTable)
      .values(data)
      .returning();

    return user;
  });

export const updateUser = createServerFn({
  method: "PUT",
})
  .middleware([authMiddleware])
  .validator(z.object({
    id: z.string(),
    data: userUpdateSchema,
  }))
  .handler(async ({ data, context }) => {
    const { id, data: updateData } = data;

    // 権限チェック
    if (context.user.id !== id && context.user.role !== "admin") {
      throw new Error("Unauthorized");
    }

    const [user] = await db
      .update(usersTable)
      .set(updateData)
      .where(eq(usersTable.id, id))
      .returning();

    return user;
  });
```

### **TanStack Start統合パターン**

```tsx
// src/routes/users/$userId.tsx
import { createFileRoute } from "@tanstack/react-router";
import { useSuspenseQuery } from "@tanstack/react-query";
import { getUserById } from "~/server/users";

export const Route = createFileRoute("/users/$userId")({
  loader: async ({ context, params }) => {
    // ★ Render-as-you-fetchパターン
    await context.queryClient.ensureQueryData({
      queryKey: ["user", params.userId],
      queryFn: () => getUserById(params.userId),
    });
  },
  component: UserDetailComponent,
});

function UserDetailComponent() {
  const { userId } = Route.useParams();

  // ★ loaderで取得済みのデータを即座に利用
  const { data: user } = useSuspenseQuery({
    queryKey: ["user", userId],
    queryFn: () => getUserById(userId),
  });

  return (
    <div>
      <h1>{user.name}</h1>
      <p>{user.email}</p>
    </div>
  );
}
```

## 📊 型安全性の確保

### **Server Functions内での型活用**

```tsx
// ✅ 推奨: 適切な型の使い分け
export const createPost = createServerFn({
  method: "POST",
})
  .validator(postInsertSchema) // ★ 外部入力はZod検証
  .handler(async ({ data }) => {
    // data は ValidatedPostInsert 型として推論される

    const [post] = await db
      .insert(postsTable)
      .values(data) // ★ 内部的にはDrizzle型で安全
      .returning();

    // post は Post 型として推論される
    return post;
  });

// ✅ 推奨: 複合的な型安全性
export const getPostsWithUser = createServerFn({
  method: "GET",
})
  .validator(z.object({
    limit: z.number().min(1).max(100).default(10),
    offset: z.number().min(0).default(0),
  }))
  .handler(async ({ data }) => {
    const posts = await db
      .select({
        id: postsTable.id,
        title: postsTable.title,
        content: postsTable.content,
        createdAt: postsTable.createdAt,
        author: {
          id: usersTable.id,
          name: usersTable.name,
          email: usersTable.email,
        },
      })
      .from(postsTable)
      .innerJoin(usersTable, eq(postsTable.userId, usersTable.id))
      .limit(data.limit)
      .offset(data.offset)
      .orderBy(desc(postsTable.createdAt));

    // 戻り値の型が自動推論される
    return posts;
  });
```

## 🚨 エラーハンドリング

### **統一されたエラー処理**

```tsx
// src/server/users.ts
import { createServerFn } from "@tanstack/react-start";
import { setResponseStatus } from "@tanstack/react-start/server";
import { db } from "~/db";
import { usersTable, userInsertSchema } from "~/db/schema";

export const createUser = createServerFn({
  method: "POST",
})
  .validator(userInsertSchema)
  .handler(async ({ data }) => {
    try {
      const [user] = await db
        .insert(usersTable)
        .values(data)
        .returning();

      return user;
    } catch (error) {
      // ★ Drizzle固有のエラーハンドリング
      if (error.code === "23505") { // PostgreSQL unique constraint violation
        setResponseStatus(409);
        throw new Error("メールアドレスが既に使用されています");
      }

      if (error.code === "23502") { // PostgreSQL not null constraint violation
        setResponseStatus(400);
        throw new Error("必須フィールドが不足しています");
      }

      console.error("User creation failed:", error);
      setResponseStatus(500);
      throw new Error("ユーザーの作成に失敗しました");
    }
  });

// ✅ 推奨: レコード存在チェック
export const getUserById = createServerFn({
  method: "GET",
})
  .validator(z.string())
  .handler(async ({ data: userId }) => {
    const [user] = await db
      .select()
      .from(usersTable)
      .where(eq(usersTable.id, userId))
      .limit(1);

    if (!user) {
      setResponseStatus(404);
      throw new Error("ユーザーが見つかりません");
    }

    return user;
  });
```

### **データベース制約の活用**

```tsx
// src/db/schema.ts
export const usersTable = pgTable("users", {
  id: text("id").primaryKey(),
  name: text("name").notNull(),
  email: text("email").notNull().unique(), // ★ DB レベルでの制約
  age: integer("age").notNull(),
  createdAt: timestamp("created_at", { withTimezone: true }).notNull().defaultNow(),
}, (table) => ({
  // ★ 複合ユニーク制約
  uniqueNameEmail: unique().on(table.name, table.email),
  // ★ チェック制約
  ageCheck: check("age_check", sql`${table.age} >= 0 AND ${table.age} <= 120`),
}));

// 対応するZodスキーマでも同様の制約を定義
export const userInsertSchema = createInsertSchema(usersTable, {
  name: (schema) => schema.min(1).max(100),
  email: (schema) => schema.email(),
  age: (schema) => schema.min(0).max(120),
});
```

