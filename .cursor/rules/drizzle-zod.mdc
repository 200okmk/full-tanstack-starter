# Drizzle ORM Project Rule

このルールは、Drizzle ORM・drizzle-zod統合による現代的なデータベース操作パターンを定義します。Single Source of Truthの徹底実現、型安全性の確保、TanStack Start Server Functions統合を重視した設計戦略を採用します。

## 🛡️ drizzle-zod統合戦略（最重要）

### **Single Source of Truth の徹底実現**

```tsx
// src/db/schema.ts - 現在のスタイルを踏襲
import { relations } from "drizzle-orm";
import { boolean, integer, pgTable, serial, text, timestamp } from "drizzle-orm/pg-core";
import { createInsertSchema, createSelectSchema, createUpdateSchema, createSchemaFactory } from 'drizzle-zod';
import { z } from 'zod';

// =============================================================================
// Schema Factory設定（プロジェクト全体で統一的なルールを適用。毎回型強制coerceの自動適用など）
// =============================================================================
const { createInsertSchema: createInsert, createSelectSchema: createSelect } = createSchemaFactory({
  coerce: {
    date: true, // 日付型の自動変換を有効化
  },
  zodInstance: z  // 拡張インスタンスを使用
});

// =============================================================================
// テーブル定義（現在のTableサフィックス命名を維持）
// =============================================================================
export const usersTable = pgTable("users", {
  id: text("id").primaryKey(),
  name: text("name").notNull(),
  email: text("email").notNull().unique(),
  emailVerified: boolean("email_verified").notNull(),
  image: text("image"),
  createdAt: timestamp("created_at", { withTimezone: true }).notNull().defaultNow(),
  updatedAt: timestamp("updated_at", { withTimezone: true })
    .notNull()
    .defaultNow()
    .$onUpdateFn(() => new Date()),
});

export const postsTable = pgTable("posts", {
  id: serial("id").primaryKey(),
  title: text("title").notNull(),
  content: text("content").notNull(),
  userId: text("user_id")
    .notNull()
    .references(() => usersTable.id, { onDelete: "cascade" }),
  createdAt: timestamp("created_at", { withTimezone: true }).notNull().defaultNow(),
  updatedAt: timestamp("updated_at", { withTimezone: true })
    .notNull()
    .defaultNow()
    .$onUpdateFn(() => new Date()),
});

// =============================================================================
// Zodスキーマ定義（drizzle-zod統合によるSingle Source of Truth）
// =============================================================================

// ★ 基本スキーマ - 自動生成
export const userInsertSchema = createInsertSchema(usersTable);
export const userSelectSchema = createSelectSchema(usersTable);
export const userUpdateSchema = createUpdateSchema(usersTable);

// ★ カスタムバリデーション付きスキーマ - 拡張/上書き
export const userInsertWithValidationSchema = createInsertSchema(usersTable, {
  name: (schema) => schema.min(1, "名前は必須です").max(100, "名前は100文字以内で入力してください"),
  email: (schema) => schema.email("有効なメールアドレスを入力してください"),
  // 完全に上書きしたい場合はZodスキーマを直接指定
  // customField: z.string().min(5).max(20),
});

export const postInsertSchema = createInsertSchema(postsTable, {
  title: (schema) => schema.min(1, "タイトルは必須です").max(200, "タイトルは200文字以内で入力してください"),
  content: (schema) => schema.min(1, "コンテンツは必須です").max(5000, "コンテンツは5000文字以内で入力してください"),
});

export const postSelectSchema = createSelectSchema(postsTable);
export const postUpdateSchema = createUpdateSchema(postsTable);

// =============================================================================
// 型定義（統一化 - 2つのパターンを併用）
// =============================================================================

// ★ パターン1: Drizzle直接型（DB内部操作用）
export type User = typeof usersTable.$inferSelect;
export type NewUser = typeof usersTable.$inferInsert;
export type Post = typeof postsTable.$inferSelect;
export type NewPost = typeof postsTable.$inferInsert;

// ★ パターン2: Zod検証付き型（Server Functions用）
export type ValidatedUserInsert = z.infer<typeof userInsertWithValidationSchema>;
export type ValidatedUserSelect = z.infer<typeof userSelectSchema>;
export type ValidatedUserUpdate = z.infer<typeof userUpdateSchema>;
export type ValidatedPostInsert = z.infer<typeof postInsertSchema>;
export type ValidatedPostSelect = z.infer<typeof postSelectSchema>;

// =============================================================================
// リレーション定義
// =============================================================================
export const usersRelations = relations(usersTable, ({ many }) => ({
  posts: many(postsTable),
}));

export const postsRelations = relations(postsTable, ({ one }) => ({
  user: one(usersTable, {
    fields: [postsTable.userId],
    references: [usersTable.id],
  }),
}));
```

