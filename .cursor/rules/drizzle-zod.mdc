### **専用ディレクトリ管理**

```tsx
// src/server/index.ts - エクスポート統合
export * from "./users";
export * from "./posts";
export * from "./comments";
export * from "./auth";

// src/server/users.ts - ユーザー関連の操作
import { createServerFn } from "@tanstack/react-start";
import { authMiddleware } from "~/lib/middleware/auth-guard";
import { db } from "~/db";
import { usersTable, userInsertSchema, userUpdateSchema } from "~/db/schema";

export const createUser = createServerFn({
  method: "POST",
})
  .validator(userInsertSchema)
  .handler(async ({ data }) => {
    const [user] = await db
      .insert(usersTable)
      .values(data)
      .returning();

    return user;
  });

export const updateUser = createServerFn({
  method: "PUT",
})
  .middleware([authMiddleware])
  .validator(z.object({
    id: z.string(),
    data: userUpdateSchema,
  }))
  .handler(async ({ data, context }) => {
    const { id, data: updateData } = data;

    // 権限チェック
    if (context.user.id !== id && context.user.role !== "admin") {
      throw new Error("Unauthorized");
    }

    const [user] = await db
      .update(usersTable)
      .set(updateData)
      .where(eq(usersTable.id, id))
      .returning();

    return user;
  });
```

### **TanStack Start統合パターン**

```tsx
// src/routes/users/$userId.tsx
import { createFileRoute } from "@tanstack/react-router";
import { useSuspenseQuery } from "@tanstack/react-query";
import { getUserById } from "~/server/users";

export const Route = createFileRoute("/users/$userId")({
  loader: async ({ context, params }) => {
    // ★ Render-as-you-fetchパターン
    await context.queryClient.ensureQueryData({
      queryKey: ["user", params.userId],
      queryFn: () => getUserById(params.userId),
    });
  },
  component: UserDetailComponent,
});

function UserDetailComponent() {
  const { userId } = Route.useParams();

  // ★ loaderで取得済みのデータを即座に利用
  const { data: user } = useSuspenseQuery({
    queryKey: ["user", userId],
    queryFn: () => getUserById(userId),
  });

  return (
    <div>
      <h1>{user.name}</h1>
      <p>{user.email}</p>
    </div>
  );
}
