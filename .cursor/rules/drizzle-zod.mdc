      title: postsTable.title,
      authorName: usersTable.name,
      authorEmail: usersTable.email,
    })
    .from(postsTable)
    .innerJoin(usersTable, eq(postsTable.userId, usersTable.id))
    .orderBy(desc(postsTable.createdAt))
    .limit(20);

  return posts;
});
```

## 🔄 マイグレーション連携

### **スキーマ変更時の注意点**

```tsx
// スキーマ変更時は以下を確認
// 1. Drizzleスキーマの更新
// 2. 関連するZodスキーマの自動更新確認
// 3. 既存のServer Functionsの型エラーチェック
// 4. マイグレーション実行

// ✅ 推奨: スキーマ変更例
export const usersTable = pgTable("users", {
  id: text("id").primaryKey(),
  name: text("name").notNull(),
  email: text("email").notNull().unique(),
  // ★ 新しい列を追加
  phoneNumber: text("phone_number"), // nullable
  isActive: boolean("is_active").notNull().default(true),
  createdAt: timestamp("created_at", { withTimezone: true }).notNull().defaultNow(),
  updatedAt: timestamp("updated_at", { withTimezone: true })
    .notNull()
    .defaultNow()
    .$onUpdateFn(() => new Date()),
});

// ★ Zodスキーマは自動的に新しい列を反映
export const userInsertSchema = createInsertSchema(usersTable, {
  name: (schema) => schema.min(1).max(100),
  email: (schema) => schema.email(),
  phoneNumber: (schema) => schema.optional().refine(
    (phone) => !phone || /^\+?[1-9]\d{1,14}$/.test(phone),
    "有効な電話番号を入力してください"
  ),
});
```

このルールに従うことで、Drizzle ORM・drizzle-zodの統合により、型安全で保守性の高いデータベース操作を実現できます。Single Source of Truthの原則を守りながら、効率的な開発を促進します。
