# TanStack Start Implementation Patterns

## 🎯 React 19 + Compiler Patterns

### Component Structure Standards
```tsx
// ✅ Preferred: Function declarations with explicit typing
function UserProfile({ userId }: { userId: string }) {
  const user = Route.useLoaderData()
  const navigate = useNavigate({ from: Route.fullPath })

  return (
    <div className="space-y-4">
      <h1 className="text-2xl font-bold">{user.name}</h1>
      {/* Component content */}
    </div>
  )
}

// ❌ Avoid: Arrow functions for components
const UserProfile = ({ userId }: { userId: string }) => { /* ... */ }
```

### React Compiler Optimization
- **Always use function declarations** for components (better for React Compiler)
- **Avoid manual memoization** (React.memo, useMemo, useCallback) - let React Compiler handle it
- **Use destructuring in function parameters** for better optimization
- **Prefer early returns** for conditional rendering

### Hook Usage Patterns
```tsx
// ✅ Type-safe route hooks with Route API
function PostDetail() {
  const params = Route.useParams()        // Type-safe params
  const search = Route.useSearch()        // Type-safe search
  const loaderData = Route.useLoaderData() // Type-safe loader data

  // Router-wide hooks require 'from' for type safety
  const navigate = useNavigate({ from: Route.fullPath })
  const matchRoute = useMatchRoute()

  return <div>{/* Component content */}</div>
}
```

## 🗂️ File-Based Routing Standards

### Route File Structure
```tsx
// src/routes/posts/$postId.tsx
import { createFileRoute } from '@tanstack/react-router'
import { z } from 'zod'

// Search params validation
const postSearchSchema = z.object({
  tab: z.enum(['details', 'comments']).optional(),
  page: z.number().min(1).optional()
})

export const Route = createFileRoute('/posts/$postId')({
  // Loader for server-side data fetching
  loader: async ({ params, context }) => {
    const post = await getPost(params.postId)
    if (!post) throw notFound()
    return { post }
  },

  // Search params validation
  validateSearch: postSearchSchema,

  // Component definition
  component: PostDetail,

  // Error boundary
  errorComponent: ({ error }) => (
    <div className="error-boundary">
      <h2>Something went wrong</h2>
      <p>{error.message}</p>
    </div>
  ),

  // Loading component
  pendingComponent: () => <div className="loading-spinner">Loading...</div>
})

function PostDetail() {
  const { post } = Route.useLoaderData()
  const { tab = 'details' } = Route.useSearch()

  return (
    <article className="prose max-w-none">
      <h1>{post.title}</h1>
      {/* Component content */}
    </article>
  )
}
```

### Route Protection Patterns
```tsx
// Protected route with authentication check
export const Route = createFileRoute('/dashboard')({
  beforeLoad: async ({ context }) => {
    if (!context.user) {
      throw redirect({ to: '/login' })
    }
  },
  loader: async ({ context }) => {
    // User is guaranteed to exist here
    return getDashboardData(context.user.id)
  },
  component: Dashboard
})
```

## 🔐 Authentication Implementation

### Better Auth Setup Pattern
```typescript
// src/lib/auth.ts
import { betterAuth } from 'better-auth'
import { drizzleAdapter } from 'better-auth/adapters/drizzle'
import { db } from './db'

export const auth = betterAuth({
  database: drizzleAdapter(db, {
    provider: 'pg',
    schema: {
      user: userTable,
      session: sessionTable,
      account: accountTable,
      verification: verificationTable
    }
  }),

  // OAuth providers configuration
  socialProviders: {
    github: {
      clientId: process.env.GITHUB_CLIENT_ID!,
      clientSecret: process.env.GITHUB_CLIENT_SECRET!
    },
    google: {
      clientId: process.env.GOOGLE_CLIENT_ID!,
      clientSecret: process.env.GOOGLE_CLIENT_SECRET!
    }
  },

  // Session configuration
  session: {
    expiresIn: 60 * 60 * 24 * 7, // 7 days
    updateAge: 60 * 60 * 24      // 1 day
  },

  // Security settings
  advanced: {
    crossSubDomainCookies: {
      enabled: true,
      domain: process.env.NODE_ENV === 'production' ? '.yourdomain.com' : undefined
    }
  }
})

export type Session = typeof auth.$Infer.Session
export type User = typeof auth.$Infer.User
```

