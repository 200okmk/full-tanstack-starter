### **フォーカス管理とキーボードナビゲーション**

```tsx
// ✅ フォーカス管理とキーボードナビゲーション
function AccessibleDropdown() {
  const [isOpen, setIsOpen] = useState(false)
  const buttonRef = useRef<HTMLButtonElement>(null)

  return (
    <div className="relative">
      <Button
        ref={buttonRef}
        onClick={() => setIsOpen(!isOpen)}
        aria-expanded={isOpen}
        aria-haspopup="true"
        className="focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
      >
        Menu
      </Button>

      {isOpen && (
        <div
          role="menu"
          className="absolute top-full mt-1 min-w-[120px] rounded-md border bg-popover p-1 shadow-lg"
          onKeyDown={(e) => {
            if (e.key === 'Escape') {
              setIsOpen(false)
              buttonRef.current?.focus()
            }
          }}
        >
          <Button
            role="menuitem"
            variant="ghost"
            className="w-full justify-start"
          >
            Profile
          </Button>
        </div>
      )}
    </div>
  )
}
```

### **ARIA属性とスクリーンリーダー対応**

```tsx
// ✅ 基本的なARIA統合
function AccessibleModal({ isOpen, onClose, title, children }: ModalProps) {
  return (
    <Dialog open={isOpen} onOpenChange={onClose}>
      <DialogContent
        role="dialog"
        aria-labelledby="modal-title"
        aria-describedby="modal-description"
        className="sm:max-w-md"
      >
        <DialogHeader>
          <DialogTitle id="modal-title">{title}</DialogTitle>
        </DialogHeader>

        <div id="modal-description" className="py-4">
          {children}
        </div>

        <DialogFooter>
          <Button variant="outline" onClick={onClose}>
            Cancel
          </Button>
          <Button onClick={onClose}>
            Confirm
          </Button>
        </DialogFooter>
      </DialogContent>
    </Dialog>
  )
}

// ✅ ローディング状態のアクセシビリティ
function AccessibleButton({ isLoading, children, ...props }: ButtonProps) {
  return (
    <Button
      disabled={isLoading}
      aria-disabled={isLoading}
      {...props}
    >
      {isLoading && (
        <div
          className="loading-spinner mr-2 h-4 w-4"
          aria-hidden="true"
        />
      )}
      {isLoading && <span className="sr-only">Loading...</span>}
      {children}
    </Button>
  )
}
```

