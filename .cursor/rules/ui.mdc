## 🎯 6. UI状態管理統合

### **Search Params基本パターン**

```tsx
import { useSearch, useNavigate } from '@tanstack/react-router'

// Search Paramsを活用したUI状態管理
function SearchableList() {
  const search = useSearch({ from: '/posts/' })
  const navigate = useNavigate({ from: '/posts' })

  const updateSearch = (updates: Partial<typeof search>) => {
    navigate({
      search: { ...search, ...updates },
    })
  }

  return (
    <div className="space-y-4">
      <div className="flex space-x-4">
        <Input
          placeholder="検索..."
          value={search.query || ''}
          onChange={(e) => updateSearch({ query: e.target.value, page: 1 })}
        />

        <Select
          value={search.category || 'all'}
          onValueChange={(value) => updateSearch({ category: value, page: 1 })}
        >
          <SelectTrigger className="w-[180px]">
            <SelectValue placeholder="カテゴリ" />
          </SelectTrigger>
          <SelectContent>
            <SelectItem value="all">すべて</SelectItem>
            <SelectItem value="tech">技術</SelectItem>
            <SelectItem value="design">デザイン</SelectItem>
          </SelectContent>
        </Select>
      </div>

      <Suspense fallback={<ListSkeleton />}>
        <PostResults search={search} />
      </Suspense>
    </div>
  )
}
```

### **Zustand補完的使用パターン**

```tsx
import { create } from 'zustand'

// 短期間のUI状態のみZustandで管理
interface UIStore {
  sidebarOpen: boolean
  toggleSidebar: () => void

  theme: 'light' | 'dark' | 'system'
  setTheme: (theme: 'light' | 'dark' | 'system') => void

  notifications: Array<{ id: string; message: string; type: 'success' | 'error' }>
  addNotification: (notification: Omit<UIStore['notifications'][0], 'id'>) => void
  removeNotification: (id: string) => void
}

const useUIStore = create<UIStore>((set) => ({
  sidebarOpen: false,
  toggleSidebar: () => set((state) => ({ sidebarOpen: !state.sidebarOpen })),

  theme: 'system',
  setTheme: (theme) => set({ theme }),

  notifications: [],
  addNotification: (notification) =>
    set((state) => ({
      notifications: [
        ...state.notifications,
        { ...notification, id: Math.random().toString(36) },
      ],
    })),
  removeNotification: (id) =>
    set((state) => ({
      notifications: state.notifications.filter((n) => n.id !== id),
    })),
}))

// UIストア使用例
function Layout({ children }: { children: React.ReactNode }) {
  const { sidebarOpen, toggleSidebar } = useUIStore()

  return (
    <div className="flex">
      <aside
        className={cn(
          "fixed inset-y-0 left-0 z-50 w-64 bg-background transition-transform",
          sidebarOpen ? "translate-x-0" : "-translate-x-full"
        )}
      >
        {/* サイドバーコンテンツ */}
      </aside>

      <main className="flex-1">
        <Button onClick={toggleSidebar}>
          サイドバー切り替え
        </Button>
        {children}
      </main>
    </div>
  )
}
```

