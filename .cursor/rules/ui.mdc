### **ARIA属性統合パターン**

```tsx
// エラー状態のアクセシブル対応
function AccessibleField({
  error,
  children
}: {
  error?: string;
  children: React.ReactNode;
}) {
  const fieldId = useId()
  const errorId = useId()

  return (
    <div>
      <div
        className={cn(
          "transition-colors",
          error && "border-destructive focus-within:border-destructive"
        )}
      >
        {React.cloneElement(children as React.ReactElement, {
          id: fieldId,
          'aria-invalid': !!error,
          'aria-describedby': error ? errorId : undefined,
        })}
      </div>

      {error && (
        <p
          id={errorId}
          className="mt-2 text-sm text-destructive"
          role="alert"
          aria-live="polite"
        >
          {error}
        </p>
      )}
    </div>
  )
}

// キーボードナビゲーション対応
function AccessibleNavigation() {
  return (
    <nav aria-label="メインナビゲーション">
      <ul className="flex space-x-4">
        <li>
          <Link
            to="/dashboard"
            className="focus-visible:ring-2 focus-visible:ring-ring rounded-md p-2"
          >
            ダッシュボード
          </Link>
        </li>
        <li>
          <Link
            to="/profile"
            className="focus-visible:ring-2 focus-visible:ring-ring rounded-md p-2"
          >
            プロフィール
          </Link>
        </li>
      </ul>
    </nav>
  )
}
