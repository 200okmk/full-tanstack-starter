## 🔄 6. Skeleton必須実装パターン

### **基本原則**

非同期データを取得する主要UIコンポーネントには、shadcn/ui Skeletonコンポーネントを使用したローディングUIを必ずセットで作成する。

```tsx
import { Skeleton } from "~/components/ui/skeleton";

// ✅ データカード + Skeleton例
function UserCard({ user }: { user: User }) {
  return (
    <div className="@container">
      <Card className="p-4">
        <div className="flex items-center gap-3">
          <img
            src={user.image}
            alt={user.name}
            className="h-10 w-10 rounded-full @md:h-12 @md:w-12"
          />
          <div>
            <h3 className="font-medium @md:text-lg">{user.name}</h3>
            <p className="text-muted-foreground text-sm @md:text-base">{user.email}</p>
          </div>
        </div>
      </Card>
    </div>
  );
}

function UserCardSkeleton() {
  return (
    <div className="@container">
      <Card className="p-4">
        <div className="flex items-center gap-3">
          <Skeleton className="h-10 w-10 rounded-full @md:h-12 @md:w-12" />
          <div className="space-y-2">
            <Skeleton className="h-4 w-24 @md:h-5 @md:w-32" />
            <Skeleton className="h-3 w-32 @md:h-4 @md:w-40" />
          </div>
        </div>
      </Card>
    </div>
  );
}

// ✅ Suspense統合パターン（@react.mdcパターン）
function UserList() {
  return (
    <Suspense fallback={<UserListSkeleton />}>
      <UserListContent />
    </Suspense>
  );
}

function UserListSkeleton() {
  return (
    <div className="space-y-4">
      {Array.from({ length: 6 }).map((_, i) => (
        <UserCardSkeleton key={i} />
      ))}
    </div>
  );
}

function UserListContent() {
  const { data: users } = useSuspenseQuery({
    queryKey: ["users"],
    queryFn: getUsers, // @tanstack-start.mdcパターン
  });

  return (
    <div className="space-y-4">
      {users.map((user) => (
        <UserCard key={user.id} user={user} />
      ))}
    </div>
  );
}
```

