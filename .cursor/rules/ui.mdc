## 📝 4. TanStack Form統一実装パターン

### **基本フォーム実装**

```tsx
import { useForm } from "@tanstack/react-form"
import { zodValidator } from "@tanstack/zod-form-adapter"
import { userInsertSchema } from "~/db/schema" // @drizzle-zod.mdcパターン

function UserForm() {
  const form = useForm({
    defaultValues: {
      name: '',
      email: '',
      bio: '',
    },
    onSubmit: async ({ value }) => {
      // @tanstack-start.mdcパターン
      await createUser(value)
    },
    validatorAdapter: zodValidator(),
  })

  return (
    <form
      onSubmit={(e) => {
        e.preventDefault()
        form.handleSubmit()
      }}
      className="space-y-6"
    >
      <form.Field
        name="name"
        validators={{
          onChange: userInsertSchema.shape.name,
        }}
        children={(field) => (
          <div className="space-y-2">
            <Label htmlFor={field.name}>Name</Label>
            <Input
              id={field.name}
              value={field.state.value}
              onBlur={field.handleBlur}
              onChange={(e) => field.handleChange(e.target.value)}
              aria-invalid={field.state.meta.errors.length > 0}
            />
            {field.state.meta.errors.length > 0 && (
              <p className="text-sm text-destructive" role="alert">
                {field.state.meta.errors[0]}
              </p>
            )}
          </div>
        )}
      />

      <form.Field
        name="email"
        validators={{
          onChange: userInsertSchema.shape.email,
        }}
        children={(field) => (
          <div className="space-y-2">
            <Label htmlFor={field.name}>Email</Label>
            <Input
              id={field.name}
              type="email"
              value={field.state.value}
              onBlur={field.handleBlur}
              onChange={(e) => field.handleChange(e.target.value)}
              aria-invalid={field.state.meta.errors.length > 0}
            />
            {field.state.meta.errors.length > 0 && (
              <p className="text-sm text-destructive" role="alert">
                {field.state.meta.errors[0]}
              </p>
            )}
          </div>
        )}
      />

      <form.Subscribe
        selector={(state) => [state.canSubmit, state.isSubmitting]}
        children={([canSubmit, isSubmitting]) => (
          <Button
            type="submit"
            disabled={!canSubmit}
            isLoading={isSubmitting}
            className="w-full sm:w-auto"
          >
            {isSubmitting ? 'Creating...' : 'Create User'}
          </Button>
        )}
      />
    </form>
  )
}
```

### **Search Params統合フォーム**

```tsx
// @tanstack-router.mdcパターンとの統合
function SearchForm() {
  const search = Route.useSearch()
  const navigate = useNavigate({ from: Route.fullPath })

  const form = useForm({
    defaultValues: {
      query: search.query || '',
      category: search.category || '',
      sort: search.sort || 'newest',
    },
    onSubmit: async ({ value }) => {
      navigate({
        search: (prev) => ({ ...prev, ...value, page: 1 })
      })
    },
  })

  return (
    <form
      onSubmit={(e) => {
        e.preventDefault()
        form.handleSubmit()
      }}
      className="flex flex-col gap-4 sm:flex-row sm:items-end"
    >
      <form.Field
        name="query"
        children={(field) => (
          <div className="flex-1">
            <Label htmlFor={field.name}>Search</Label>
            <Input
              id={field.name}
              placeholder="Search products..."
              value={field.state.value}
              onChange={(e) => field.handleChange(e.target.value)}
            />
          </div>
        )}
      />

      <Button type="submit" className="sm:w-auto">
        Search
      </Button>
    </form>
  )
}
```

