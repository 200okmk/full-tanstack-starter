### フォームデータ処理パターン

```tsx
// FormData処理のServer Function
export const createPost = createServerFn({
  method: 'POST'
})
  .validator((data) => {
    if (!(data instanceof FormData)) {
      throw new Error('Invalid form data')
    }

    const title = data.get('title')
    const content = data.get('content')

    if (!title || !content) {
      throw new Error('Title and content are required')
    }

    return {
      title: title.toString(),
      content: content.toString()
    }
  })
  .handler(async ({ data, context }) => {
    // 認証チェック
    if (!context.user) {
      throw new Error('Authentication required')
    }

    // Drizzle ORM SQL-like方式でのinsert
    const [newPost] = await db
      .insert(posts)
      .values({
        ...data,
        authorId: context.user.id,
      })
      .returning()

    return newPost
  })
```

### ストリーミングServer Function

```tsx
// ストリーミング対応
export const streamData = createServerFn({
  method: 'GET',
  response: 'raw'
}).handler(async ({ signal }) => {
  const stream = new ReadableStream({
    async start(controller) {
      let count = 0

      const interval = setInterval(() => {
        if (signal.aborted) {
          clearInterval(interval)
          controller.close()
          return
        }

        controller.enqueue(
          new TextEncoder().encode(`data: ${JSON.stringify({ count: ++count })}\n\n`)
        )

        if (count >= 10) {
          clearInterval(interval)
          controller.close()
        }
      }, 1000)

      signal.addEventListener('abort', () => {
        clearInterval(interval)
        controller.close()
      })
    }
  })

  return new Response(stream, {
    headers: {
      'Content-Type': 'text/event-stream',
      'Cache-Control': 'no-cache',
      'Connection': 'keep-alive'
    }
  })
})
```

## 🛡️ Middleware実装標準

### 認証ミドルウェア

```tsx
// src/lib/middleware/auth.ts
import { createMiddleware } from '@tanstack/react-start'
import { getWebRequest, setResponseStatus } from '@tanstack/react-start/server'
import { auth } from '~/lib/auth'

export const authMiddleware = createMiddleware().server(async ({ next }) => {
  const { headers } = getWebRequest()!

  const session = await auth.api.getSession({
    headers,
    query: {
      disableCookieCache: true // セッションを最新に保つ
    }
  })

  if (!session) {
    setResponseStatus(401)
    throw new Error('Authentication required')
  }

  return next({ context: { user: session.user } })
})

// オプショナル認証ミドルウェア
export const optionalAuthMiddleware = createMiddleware().server(async ({ next }) => {
  const { headers } = getWebRequest()!

  const session = await auth.api.getSession({ headers })

  return next({
    context: {
      user: session?.user ?? null
    }
  })
})
```

### バリデーションミドルウェア

```tsx
// src/lib/middleware/validation.ts
import { createMiddleware } from '@tanstack/react-start'
import { z } from 'zod'

export const createValidationMiddleware = <T>(schema: z.ZodSchema<T>) => {
  return createMiddleware().server(async ({ next, data }) => {
    try {
      const validatedData = schema.parse(data)
      return next({ data: validatedData })
    } catch (error) {
      if (error instanceof z.ZodError) {
        throw new Error(`Validation failed: ${error.errors.map(e => e.message).join(', ')}`)
      }
      throw error
    }
  })
}
```

### ログミドルウェア

```tsx
// src/lib/middleware/logging.ts
import { createMiddleware } from '@tanstack/react-start'

export const loggingMiddleware = createMiddleware().server(async ({ next }) => {
  const startTime = Date.now()
  const requestId = Math.random().toString(36).substr(2, 9)

  console.log(`[${requestId}] Server function started at ${new Date().toISOString()}`)

  try {
    const result = await next()
    console.log(`[${requestId}] Completed in ${Date.now() - startTime}ms`)
    return result
  } catch (error) {
    console.error(`[${requestId}] Failed in ${Date.now() - startTime}ms:`, error)
    throw error
  }
})
```

### エラー処理ミドルウェア

```tsx
// src/lib/middleware/error-handling.ts
import { createMiddleware } from '@tanstack/react-start'
import { setResponseStatus } from '@tanstack/react-start/server'

export const errorHandlingMiddleware = createMiddleware().server(async ({ next }) => {
  try {
    return await next()
  } catch (error) {
    // エラーの種類に応じてステータスコードを設定
    if (error.message.includes('Authentication')) {
      setResponseStatus(401)
    } else if (error.message.includes('Validation')) {
      setResponseStatus(400)
    } else if (error.message.includes('Not found')) {
      setResponseStatus(404)
    } else {
      setResponseStatus(500)
    }

    // 本番環境では詳細なエラーを隠す
    const message = process.env.NODE_ENV === 'production'
      ? 'Internal server error'
      : error.message

    throw new Error(message)
  }
})
```

### ミドルウェアの組み合わせパターン

```tsx
// 複数ミドルウェアの使用例
export const protectedServerFn = createServerFn()
  .middleware([
    loggingMiddleware,
    errorHandlingMiddleware,
    authMiddleware
  ])
  .handler(async ({ context }) => {
    // context.user は型安全にアクセス可能
    return `Hello, ${context.user.name}!`
  })
```

