# TanStack Start Rule
このルールは、TanStack Startにおけるサーバー関数、ミドルウェア、SSR/ストリーミング、APIルートの実装パターンを定義します。型安全性、パフォーマンス、保守性を重視した実装戦略を採用します。

## 🔧 Server Functions設計パターン

### 基本的なServer Function定義

```tsx
// src/server/example.ts
import { createServerFn } from '@tanstack/react-start'
import { z } from 'zod'
import { eq } from 'drizzle-orm'
import { db } from '~/lib/db'
import { users, profiles } from '~/lib/db/schemas'

// バリデーションスキーマの定義
const getUserSchema = z.object({
  id: z.string().min(1),
  includeProfile: z.boolean().default(false)
})

// 基本的なServer Function
export const getUser = createServerFn({
  method: 'GET',
})
  .validator(getUserSchema)
  .handler(async ({ data }) => {
    const { id, includeProfile } = data

    try {
      // Drizzle ORM SQL-like方式でのクエリ
      let query = db.select().from(users).where(eq(users.id, id))

      if (includeProfile) {
        query = db
          .select()
          .from(users)
          .leftJoin(profiles, eq(users.id, profiles.userId))
          .where(eq(users.id, id))
      }

      const result = await query

      if (!result.length) {
        throw new Error('User not found')
      }

      return includeProfile ? result[0] : result[0]
    } catch (error) {
      console.error('Failed to fetch user:', error)
      throw new Error('Failed to fetch user')
    }
  })
```

