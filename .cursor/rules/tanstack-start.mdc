# TanStack Start Rule
このルールは、TanStack StartにおけるServer Functions、ミドルウェア、SSR/ストリーミング、APIルートの実装パターンを定義します。型安全性、パフォーマンス、保守性を重視した実装戦略を採用します。

## 🔧 Server Functions設計パターン

### 基本的なServer Function定義

```tsx
// lib/api/example.ts
import { createServerFn } from '@tanstack/react-start'
import { eq } from 'drizzle-orm'
import { db } from '~/db'
import { usersTable, postsTable, userSelectSchema } from '~/db/schema' // ✅ schema.tsからインポート
import { authMiddleware } from '~/lib/middlewares'

// 基本的なGET Server Function（認証なし）
export const getUser = createServerFn({
  method: 'GET',
})
  .validator(userSelectSchema.pick({ id: true })) // ✅ schema.tsのスキーマ使用
  .handler(async ({ data }) => {
    const { id } = data

    try {
      // Drizzle ORM SQL-like方式でのクエリ
      const [user] = await db
        .select()
        .from(usersTable)
        .where(eq(usersTable.id, id))

      if (!user) {
        throw new Error('User not found')
      }

      return user
    } catch (error) {
      console.error('Failed to fetch user:', error)
      throw new Error('Failed to fetch user')
    }
  })
```

### 設定オプションの活用

```tsx
// レスポンス形式の制御
export const getRawResponse = createServerFn({
  method: 'GET',
  response: 'raw', // Response オブジェクトを直接返す
}).handler(async () => {
  return new Response('Hello, World!', {
    headers: { 'Content-Type': 'text/plain' }
  })
})

// 静的Server Function（ビルド時実行）
export const getStaticData = createServerFn({
  type: 'static'
}).handler(async () => {
  return {
    buildTime: new Date().toISOString(),
    version: process.env.npm_package_version
  }
})
```

### 標準的なPOST Server Function（認証あり）

```tsx
// ✅ 標準パターン：schema.tsスキーマ + 認証ミドルウェア
import { postInsertSchema } from '~/db/schema' // ✅ schema.tsからインポート

export const createPost = createServerFn({
  method: 'POST'
})
  .validator(postInsertSchema.omit({ userId: true, id: true })) // ✅ schema.tsのスキーマ使用
  .middleware([authMiddleware]) // ✅ 認証ミドルウェア必須適用
  .handler(async ({ data, context }) => {
    // context.sessionUserは認証済み保証

    // Drizzle ORM SQL-like方式でのinsert
    const [newPost] = await db
      .insert(postsTable)
      .values({
        ...data,
        userId: context.sessionUser.id, // 認証ユーザーのIDを自動設定
      })
      .returning()

    return newPost
  })
```

### フォームデータ処理パターン

```tsx
// ✅ FormData + schema.tsスキーマでバリデーション
import { postInsertSchema } from '~/db/schema' // ✅ schema.tsからインポート

export const createPostFromForm = createServerFn({
  method: 'POST'
})
  .validator((formData) => {
    if (!(formData instanceof FormData)) {
      throw new Error('Invalid form data')
    }

    // FormDataをオブジェクトに変換
    const rawData = {
      title: formData.get('title')?.toString(),
      content: formData.get('content')?.toString(),
    }

    // ✅ schema.tsのスキーマで最終検証
    return postInsertSchema.omit({ userId: true, id: true }).parse(rawData)
  })
  .middleware([authMiddleware]) // ✅ 認証ミドルウェア必須適用
  .handler(async ({ data, context }) => {
    const [newPost] = await db
      .insert(postsTable)
      .values({
        ...data,
        userId: context.sessionUser.id,
      })
      .returning()

    return newPost
  })
```

### 例外：認証不要のServer Function（明示的コメント必須）

```tsx
// ✅ 例外パターン：パブリックなお問い合わせフォーム
export const submitContactForm = createServerFn({ method: 'POST' })
  .validator(z.object({
    name: z.string().min(1),
    email: z.string().email(),
    message: z.string().min(10)
    // 注：一時的なフォームデータ（DBに保存されない）
  }))
  // 認証ミドルウェア適用なし（パブリックフォームのため）
  .handler(async ({ data }) => {
    await sendEmail(data)
    return { success: true }
  })
```

### 複雑なバリデーション処理

```tsx
// ✅ 複雑な変換処理を含む場合
import { userUpdateSchema } from '~/db/schema' // ✅ schema.tsからインポート

export const updateUserProfile = createServerFn({ method: 'POST' })
  .validator((formData) => {
    if (!(formData instanceof FormData)) {
      throw new Error('Invalid form data')
    }

    // 複雑なFormData変換ロジック
    const avatar = formData.get('avatar') as File
    const rawData = {
      name: formData.get('name')?.toString(),
      image: avatar?.size > 0 ? avatar : undefined,
    }

    // ✅ 最終的にはschema.tsのスキーマで検証
    return userUpdateSchema.pick({ name: true, image: true }).parse(rawData)
  })
  .middleware([authMiddleware]) // ✅ 認証ミドルウェア必須適用
  .handler(async ({ data, context }) => {
    const [updatedUser] = await db
      .update(usersTable)
      .set({ ...data, updatedAt: new Date() })
      .where(eq(usersTable.id, context.sessionUser.id))
      .returning()

    return updatedUser
  })
```

### ストリーミングServer Function

```tsx
// ストリーミング対応（認証あり）
export const streamUserData = createServerFn({
  method: 'GET',
  response: 'raw'
})
  .middleware([authMiddleware]) // ✅ ユーザー固有データのため認証必要
  .handler(async ({ context, signal }) => {
    const stream = new ReadableStream({
      async start(controller) {
        let count = 0

        const interval = setInterval(async () => {
          if (signal.aborted) {
            clearInterval(interval)
            controller.close()
            return
          }

          // 認証ユーザーのデータをストリーミング
          const data = await getUserStreamData(context.sessionUser.id, count++)
          controller.enqueue(
            new TextEncoder().encode(`data: ${JSON.stringify(data)}\n\n`)
          )

          if (count >= 10) {
            clearInterval(interval)
            controller.close()
          }
        }, 1000)

        signal.addEventListener('abort', () => {
          clearInterval(interval)
          controller.close()
        })
      }
    })

    return new Response(stream, {
      headers: {
        'Content-Type': 'text/event-stream',
        'Cache-Control': 'no-cache',
        'Connection': 'keep-alive'
      }
    })
  })
```

## 🛡️ Middleware実装標準

### 認証ミドルウェア

```tsx
// src/lib/middlewares.ts
import { createMiddleware } from '@tanstack/react-start'
import { getWebRequest, setResponseStatus } from '@tanstack/react-start/server'
import { auth } from '~/lib/auth'

export const authMiddleware = createMiddleware().server(async ({ next }) => {
  const { headers } = getWebRequest()!

  const session = await auth.api.getSession({
    headers,
    query: {
      disableCookieCache: true // セッションを最新に保つ
    }
  })

  if (!session) {
    setResponseStatus(401)
    throw new Error('Authentication required')
  }

  return next({ context: { sessionUser: session.user } })
})
```

#### **🚨 重要：POSTメソッドには基本的に認証ミドルウェア適用**

**基本方針**: 全てのPOSTメソッドServer Functionには**`authMiddleware`を適用**することが必須です。

#### **適用判断のチェックリスト**

Server Function作成時は以下をチェック：

- ☑️ **POSTメソッドである？** → `authMiddleware`適用
- ☑️ **データの作成・更新・削除を行う？** → `authMiddleware`必須
- ☑️ **ユーザー固有データにアクセスする？** → `authMiddleware`必須
- ☑️ **所有者チェックが必要？** → `authMiddleware`必須

#### **例外ケース（明示的にコメントで説明必須）**

以下の限定的なケースのみ、認証ミドルウェアを適用しない：

```tsx

// ✅ 例外1：パブリックなフォーム送信
export const submitNewsletterSignup = createServerFn({ method: 'POST' })
  // 認証ミドルウェア適用なし（パブリックフォームのため）

// ✅ 例外2：外部API連携（Webhook受信など）
export const receiveWebhook = createServerFn({ method: 'POST' })
  // 認証ミドルウェア適用なし（外部システムからの呼び出しのため）
```

### 権限レベル別ミドルウェア戦略

```tsx
// 管理者専用ミドルウェア
export const adminMiddleware = createMiddleware().server(async ({ next, context }) => {
  if (!context.sessionUser?.isAdmin) {
    setResponseStatus(403)
    throw new Error('Admin access required')
  }

  return next({ context })
})

// ✅ 使用例：段階的権限チェック
import { userSelectSchema } from '~/db/schema' // ✅ schema.tsからインポート

export const deleteUser = createServerFn({ method: 'POST' })
  .validator(userSelectSchema.pick({ id: true })) // ✅ schema.tsのスキーマ使用
  .middleware([
    authMiddleware,   // 1. 認証チェック
    adminMiddleware   // 2. 管理者権限チェック
  ])
  .handler(async ({ data: { id }, context }) => {
    // context.sessionUser は認証済み且つ管理者である事が保証済み
    return db.delete(usersTable).where(eq(usersTable.id, id))
  })
```

### バリデーションミドルウェア

```tsx
// src/lib/middlewares.ts
import { createMiddleware } from '@tanstack/react-start'
import { z } from 'zod'

export const createValidationMiddleware = <T>(schema: z.ZodSchema<T>) => {
  return createMiddleware().server(async ({ next, data }) => {
    try {
      const validatedData = schema.parse(data)
      return next({ data: validatedData })
    } catch (error) {
      if (error instanceof z.ZodError) {
        throw new Error(`Validation failed: ${error.errors.map(e => e.message).join(', ')}`)
      }
      throw error
    }
  })
}
```

## 🌊 SSR/Streaming戦略

### 基本SSR設定

```tsx
// src/ssr.tsx
import { getRouterManifest } from '@tanstack/react-start/router-manifest'
import { createStartHandler, defaultStreamHandler } from '@tanstack/react-start/server'
import { createRouter } from './router'

export default createStartHandler({
  createRouter,
  getRouterManifest
})(defaultStreamHandler)
```

### メタデータとSEO対応

```tsx
// src/routes/__root.tsx
export const Route = createRootRouteWithContext<{
  queryClient: QueryClient
  sessionUser: User | null
}>()({
  head: ({ matches }) => {
    const match = matches[matches.length - 1]
    const title = match?.meta?.title ?? 'Default Title'
    const description = match?.meta?.description ?? 'Default Description'

    return {
      meta: [
        { charSet: 'utf-8' },
        { name: 'viewport', content: 'width=device-width, initial-scale=1' },
        { title },
        { name: 'description', content: description },
        { property: 'og:title', content: title },
        { property: 'og:description', content: description }
      ],
      links: [
        { rel: 'stylesheet', href: appCss },
        { rel: 'canonical', href: `https://example.com${match?.pathname}` }
      ]
    }
  }
})
```

### ストリーミング最適化

```tsx
// ルートレベルでのストリーミング対応
export const Route = createFileRoute('/posts')({
  loader: async ({ context }) => {
    // データを並列で取得
