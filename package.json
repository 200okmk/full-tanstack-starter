{
  "name": "tsstart-drizzle-betterauth",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinxi dev",
    "build": "vinxi build",
    "start": "vinxi start",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "db": "drizzle-kit",
    "deps": "pnpm dlx npm-check-updates@latest --interactive --format group",
    "ui": "pnpm dlx shadcn@latest",
    "auth": "pnpm dlx @better-auth/cli@latest",
    "auth:generate": "pnpm dlx @better-auth/cli@latest generate --y --output ./src/db/schema.ts && prettier --write ./src/db/schema.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0",
    "@radix-ui/react-label": "^2.1.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@tanstack/react-query": "^5.74.11",
    "@tanstack/react-router": "^1.139.10",
    "@tanstack/react-router-with-query": "^1.119.0",
    "@tanstack/react-start": "^1.139.10",
    "better-auth": "^1.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.43.1",
    "drizzle-zod": "^0.8.2",
    "lucide-react": "^0.503.0",
    "postgres": "^3.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.2.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^2.3.9",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.8",
    "@tanstack/eslint-plugin-query": "^5.91.2",
    "@tanstack/eslint-plugin-router": "^1.139.0",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@tanstack/react-router-devtools": "^1.139.6",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "^0.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "prettier": "^3.7.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "shadcn": "^3.5.0",
    "tailwindcss": "^4.1.5",
    "tw-animate-css": "^1.2.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.2.4",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
