# development | production
NODE_ENV=development
# サーバーサイド用
BASE_URL=http://localhost:3000
# クライアントサイド用
VITE_BASE_URL=http://localhost:3000

# Docker Composeによって起動されたローカルPostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/local_db

# Better Auth
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# OAuth2 Providers, optional
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NOTE:
# In your OAuth2 apps, set callback/redirect URIs to`http://localhost:3000/api/auth/callback/<provider>`
# e.g. http://localhost:3000/api/auth/callback/github