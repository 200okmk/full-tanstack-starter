# -------------------------------------------------------------------
# ローカル開発環境用設定
# -------------------------------------------------------------------
VITE_BASE_URL=http://localhost:3000

# -------------------------------------------------------------------
# データベース設定
# -------------------------------------------------------------------
# ローカルで立ち上げるDocker Compose上のPostgresのアドレス
# 本番とプレビュー環境用は、Neonなどで作成したリモート上のPostgres接続文字列をデプロイプラットフォームのダッシュボードから設定する。
DATABASE_URL=postgresql://user:password@localhost:5432/local_db

# -------------------------------------------------------------------
# 認証設定
# -------------------------------------------------------------------
# Better Auth用の秘密鍵（本番環境では必ず変更してください）
BETTER_AUTH_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -------------------------------------------------------------------
# Netlify デプロイ時の注意
# -------------------------------------------------------------------
# Netlifyでは以下の環境変数をダッシュボードで設定してください：
# 必須：
# - DATABASE_URL (本番用Neon URL)
# - BETTER_AUTH_SECRET
# オプション：
# - GITHUB_CLIENT_ID & GITHUB_CLIENT_SECRET
# - GOOGLE_CLIENT_ID & GOOGLE_CLIENT_SECRET
#
# URLは自動的に検出されるため設定不要です。
